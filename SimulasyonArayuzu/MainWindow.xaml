<Window x:Class="SimulasyonArayuzu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimulasyonArayuzu"
        mc:Ignorable="d"
        Title="AvioSync - Aviyonik Simülasyon Arayüzü"
        Height="640" Width="980"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0E1726"
        FontFamily="Segoe UI"
        Foreground="#E6EDF3">

    <Window.Resources>
        <!-- Ortak renkler -->
        <SolidColorBrush x:Key="PanelArkaPlan"  Color="#152234"/>
        <SolidColorBrush x:Key="PanelKenar"     Color="#22304A"/>
        <SolidColorBrush x:Key="VurguMavi"      Color="#3D8BFD"/>
        <SolidColorBrush x:Key="VurguYesil"     Color="#22C55E"/>
        <SolidColorBrush x:Key="VurguKirmizi"   Color="#EF4444"/>
        <SolidColorBrush x:Key="YumusakYazi"    Color="#94A3B8"/>

        <!-- Panel (kart) stili -->
        <Style x:Key="PanelStili" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelArkaPlan}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelKenar}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Başlık stili -->
        <Style x:Key="PanelBaslik" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource YumusakYazi}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- Değer (büyük) stili -->
        <Style x:Key="DegerBuyuk" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Etiket-değer satırı (yatay) -->
        <Style x:Key="EtiketStili" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource YumusakYazi}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="DegerStili" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- Buton stili -->
        <Style x:Key="AnaButon" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VurguMavi}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="kenar"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="kenar" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="kenar" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST BAŞLIK ŞERİDİ -->
        <Border Grid.Row="0" Style="{StaticResource PanelStili}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="AVIYONIK SİMÜLASYON ARAYÜZÜ"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource VurguMavi}"/>
                    <TextBlock x:Name="txtBaglantiBilgisi"
                               Text="UDP Dinleme: 0.0.0.0:5002 | Hedef: 127.0.0.1:5001 | 5 Hz telemetri"
                               Foreground="{StaticResource YumusakYazi}"
                               FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="SİSTEM ZAMANI" Style="{StaticResource PanelBaslik}"/>
                    <TextBlock x:Name="txtSistemZamani" Text="00:00:00"
                               FontFamily="Consolas" FontSize="22" FontWeight="Bold"
                               Foreground="#E6EDF3"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnBaslat" Content="BAŞLAT"
                            Style="{StaticResource AnaButon}"
                            Background="{StaticResource VurguYesil}"
                            Click="BtnBaslat_Click" Margin="4,0"/>
                    <Button x:Name="btnDurdur" Content="DURDUR"
                            Style="{StaticResource AnaButon}"
                            Background="{StaticResource VurguKirmizi}"
                            Click="BtnDurdur_Click" Margin="4,0"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DURUM + LED + SAYAÇLAR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Çalışma Durumu -->
            <Border Grid.Column="0" Style="{StaticResource PanelStili}">
                <StackPanel>
                    <TextBlock Text="ÇALIŞMA DURUMU" Style="{StaticResource PanelBaslik}"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="elpDurumIsigi" Width="14" Height="14"
                                 Fill="{StaticResource VurguKirmizi}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDurum" Text="DURDURULDU"
                                   Style="{StaticResource DegerBuyuk}"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="txtGonderilenSayisi"
                               Text="Gönderilen telemetri: 0"
                               Style="{StaticResource EtiketStili}"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- LED -->
            <Border Grid.Column="1" Style="{StaticResource PanelStili}">
                <StackPanel>
                    <TextBlock Text="AYAR LED'İ" Style="{StaticResource PanelBaslik}"/>
                    <Grid HorizontalAlignment="Left">
                        <Ellipse x:Name="elpLedHale" Width="64" Height="64"
                                 Fill="#2A1F1F" Opacity="0.6"/>
                        <Ellipse x:Name="elpLed" Width="44" Height="44"
                                 Fill="#3A2828" Stroke="#553030" StrokeThickness="2"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="txtLedDurumu" Text="SÖNDÜ"
                               Style="{StaticResource DegerStili}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="txtSonAyar"
                               Text="Son ayar: —"
                               Style="{StaticResource EtiketStili}"/>
                </StackPanel>
            </Border>

            <!-- Paket Sayaçları -->
            <Border Grid.Column="2" Style="{StaticResource PanelStili}">
                <StackPanel>
                    <TextBlock Text="PAKET YAKALAMA SAYAÇLARI" Style="{StaticResource PanelBaslik}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DOĞRU" Style="{StaticResource EtiketStili}"/>
                            <TextBlock x:Name="txtDogruSayac" Text="0"
                                       Style="{StaticResource DegerBuyuk}"
                                       Foreground="{StaticResource VurguYesil}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="HATALI" Style="{StaticResource EtiketStili}"/>
                            <TextBlock x:Name="txtHataliSayac" Text="0"
                                       Style="{StaticResource DegerBuyuk}"
                                       Foreground="{StaticResource VurguKirmizi}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- AYARLAR + KOMUT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Mevcut Ayarlar -->
            <Border Grid.Column="0" Style="{StaticResource PanelStili}">
                <StackPanel>
                    <TextBlock Text="AVIYONIK GÜNCEL AYARLARI" Style="{StaticResource PanelBaslik}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="İrtifa" Style="{StaticResource EtiketStili}"/>
                            <TextBlock x:Name="txtIrtifa" Text="0.00"
                                       Style="{StaticResource DegerBuyuk}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hız" Style="{StaticResource EtiketStili}"/>
                            <TextBlock x:Name="txtHiz" Text="0.00"
                                       Style="{StaticResource DegerBuyuk}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sıcaklık" Style="{StaticResource EtiketStili}"/>
                            <TextBlock x:Name="txtSicaklik" Text="0.00"
                                       Style="{StaticResource DegerBuyuk}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Son Komut -->
            <Border Grid.Column="1" Style="{StaticResource PanelStili}">
                <StackPanel>
                    <TextBlock Text="SON GELEN KOMUT" Style="{StaticResource PanelBaslik}"/>
                    <TextBlock x:Name="txtSonKomut" Text="—"
                               Style="{StaticResource DegerBuyuk}"
                               Foreground="{StaticResource VurguMavi}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OLAY GÜNLÜĞÜ -->
        <Border Grid.Row="3" Style="{StaticResource PanelStili}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="OLAY GÜNLÜĞÜ" Style="{StaticResource PanelBaslik}"/>
                <ListBox x:Name="lstOlaylar" Grid.Row="1"
                         Background="#0B1422"
                         BorderBrush="{StaticResource PanelKenar}"
                         Foreground="#CBD5E1"
                         FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</Window>
